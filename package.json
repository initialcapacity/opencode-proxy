{
  "name": "opencode-proxy",
  "version": "0.0.0",
  "private": true,
	"scripts": {
		"build:codex": "node scripts/build-codex.mjs",
		"build:agents": "node scripts/build-agents.mjs",
		"build:config": "npm run build:codex && npm run build:agents",
		"predeploy": "npm run build:config",
		"deploy": "wrangler deploy",
		"deploy:github-mcp": "wrangler deploy -c wrangler.github-mcp.jsonc",
		"predev": "npm run build:config",
		"dev": "wrangler dev",
		"dev:github-mcp": "wrangler dev -c wrangler.github-mcp.jsonc",
		"start": "wrangler dev",
		"pretest": "npm run build:config",
		"test": "vitest",
		"pretypecheck": "npm run build:config",
		"typecheck": "tsc --noEmit && tsc --noEmit -p test && tsc --noEmit -p github-mcp",
		"prepare": "npm run build:config",
		"cf-typegen": "wrangler types"
	},
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.4",
    "@types/node": "^25.6.0",
    "typescript": "^5.5.2",
    "vitest": "~3.2.0",
    "wrangler": "^4.84.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "agents": "^0.11.4",
    "hono": "^4.12.14",
    "zod": "^4.3.6"
  }
}
